{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "serve": "php artisan serve --port=8088",
    "all": "concurrently -n laravel,vite \"php artisan serve --port=8088\" \"npm run dev\"",
    "all:host": "concurrently -n laravel,vite \"php artisan serve --host=0.0.0.0 --port=8088\" \"npm run dev -- --host\""
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "axios": "^1.11.0",
    "concurrently": "^9.0.1",
    "laravel-vite-plugin": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.7"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "alpinejs": "^3.16.1",
    "chart.js": "^4.5.1",
    "choices.js": "^11.2.3",
    "driver.js": "^1.8.0",
    "flatpickr": "^4.6.13",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
    "sweetalert2": "^11.26.25",
    "toastify-js": "^1.12.0",
    "vue": "^3.5.41"
  }
}
